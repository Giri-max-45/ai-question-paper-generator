# Copy this file to .env and fill values as stages progress.
# Stage 1 does not need an LLM key.

APP_NAME=AI Question Generator
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Stage 8
DUPLICATE_THRESHOLD=0.85

# Stage 6+ (leave empty until then)
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Stage 4
EMBEDDING_MODEL=all-MiniLM-L6-v2
